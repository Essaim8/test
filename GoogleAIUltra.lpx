[Script]
http-response ^https?:\/\/one\.google\.com\/ai(\?|$) script-path=https://raw.githubusercontent.com/Essaim8/test/main/GoogleAIUltra.js, requires-body=true, timeout=30, tag=GoogleOne-AIUltra

[MitM]
hostname = one.google.com
