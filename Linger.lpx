#!name=Linger Pro 解锁
#!desc=解锁 Linger (com.libowang.Linger.Global) 的 Pro。原理：会员状态来自 RevenueCat，权益标识 "Pro access"（写在 App 的 Info.plist 里），App 未启用强制验签，本插件把 CustomerInfo 接口返回成已购买 Pro。需开启 MitM。
#!author=@Essaim
#!icon=https://raw.githubusercontent.com/Essaim8/test/main/icon/linger.png
#!other=Linger.Loon.plugin

[Script]
http-response ^https?:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/v1\/subscribers\/[^\/?]+(\?.*)?$ script-path=https://raw.githubusercontent.com/Essaim8/test/main/LingerPro.js, requires-body=true, timeout=30, tag=Linger-Pro

[MitM]
hostname = api.revenuecat.com, api.rc-backup.com
