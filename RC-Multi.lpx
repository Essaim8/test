#!name=RevenueCat 多App解锁（Scrollie + Linger）
#!desc=统一解锁 Scrollie 与 Linger 的 Pro。为什么必须合成一个插件：Loon 对一条 URL 只执行第一个匹配的 http-response 脚本，而这两个 App 的 CustomerInfo 接口路径完全相同（/v1/subscribers/<id>），正则无法区分——拆成两个插件时，加载顺序靠前的那个会把另一个 App 的请求一起改写掉（实测：Scrollie 的请求命中了 Linger-Pro，被写成只有 'Pro access' 的响应，自己的 'Scrollie Pro' 被覆盖）。本插件内部按 User-Agent 分流（Scrollie/ → Scrollie Pro，Linger/ → Pro access），认不出的 App 原样放行。需开启 MitM。
#!author=@Essaim
#!icon=https://raw.githubusercontent.com/Essaim8/test/main/icon/scrollie.png
#!other=RC-Multi.Loon.plugin

[Script]
http-response ^https?:\/\/(api\.rc-backup\.com|api\.revenuecat\.com)\/v1\/subscribers\/[^\/?]+(\?.*)?$ script-path=https://raw.githubusercontent.com/Essaim8/test/main/RC-Multi.js, requires-body=true, timeout=30, tag=RC-Multi

[MitM]
hostname = api.rc-backup.com, api.revenuecat.com
