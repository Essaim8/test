#!name=飓风相机 账号响应诊断（只读）
#!desc=只读诊断插件：把 base.ysjf.com 等自家接口的真实响应打印到 Loon 脚本日志（token 类字段已打码），不改动任何响应。用于确认 get_info 的 data 结构以及 memberships 的实际内容，为后续精确伪造提供依据。
#!author=@Essaim
#!other=StormCamDebug.Loon.plugin

[Script]
http-response ^https?:\/\/[^\/]*ysjf\.com\/ script-path=https://raw.githubusercontent.com/Essaim8/test/main/StormCamDebug.js, requires-body=true, timeout=30, tag=StormCam-Debug

[MitM]
hostname = base.ysjf.com, api.ysjf.com, properties.ysjf.com, message.ysjf.com
