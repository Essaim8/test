#!name=Scrollie Pro 解锁
#!desc=解锁 Scrollie (com.foamzou.scrollie) 的 Pro 权益（HD 导出、去水印等）。原理：会员状态由 RevenueCat 提供，唯一权益是 "Scrollie Pro"；App 未启用强制验签，本插件把 CustomerInfo 接口返回成已购买终身 Pro。需开启 MitM。
#!author=@Essaim
#!icon=https://raw.githubusercontent.com/Essaim8/test/main/icon/scrollie.png
#!other=Scrollie.Loon.plugin

[Script]
http-response ^https?:\/\/(api\.rc-backup\.com|api\.revenuecat\.com)\/v1\/subscribers\/[^\/?]+(\?.*)?$ script-path=https://raw.githubusercontent.com/Essaim8/test/main/ScrolliePro.js, requires-body=true, timeout=30, tag=Scrollie-Pro

[MitM]
hostname = api.rc-backup.com, api.revenuecat.com
