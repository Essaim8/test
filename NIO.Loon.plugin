#!name=蔚来每日签到
#!desc=蔚来 App(com.do1.WeiLaiApp) 每日自动签到。原理：抓包显示同一个签到动作有两条通道——native 的 POST app.nio.com/c/award_cn/checkin 带 sha256 sign 且服务端防重放(原样重放返回 sign_replay、只改 timestamp 返回 invalid sign)，签名无法离线复刻；而 webview 通道 gateway-front-external.nio.com/moat/10086/c/award_cn/checkin 客户端不传 sign，由网关自己补签，只认 authorization: Bearer。本插件在 http-request 阶段从 App 自己的请求里抄 token(authorization 头或 URL 的 accessToken)，并在 App 启动心跳请求经过时当场完成签到(token 必然新鲜)，另配 cron 与手动按钮兜底。不改安装包、无需越狱。**前提：已登录**；打开一次 App 即会自动抓 token 并签到，会弹「登录态已捕获 / 签到成功」。
#!author=@Essaim
#!icon=https://raw.githubusercontent.com/Essaim8/test/main/icon/nio.png
#!other=NIO.Loon.plugin

[Script]
# 抄 token + 心跳时当场签到：必须在 http-request 阶段取($request.headers / $request.url)
http-request ^https?:\/\/(?:app|gateway-front|api-fx|icar|matrix-api)[a-z-]*\.nio\.com\/ script-path=https://raw.githubusercontent.com/Essaim8/test/main/NIOCheckIn.js, timeout=10, tag=蔚来-登录态
# 定时兜底（默认每天 09:07，可自行改）
cron "7 9 * * *" script-path=https://raw.githubusercontent.com/Essaim8/test/main/NIOCheckIn.js, tag=蔚来-每日签到
# 手动触发：插件详情页点一下立即签到/自检
generic script-path=https://raw.githubusercontent.com/Essaim8/test/main/NIOCheckIn.js, tag=蔚来-立即签到, img-url=checkmark.circle.system

[MitM]
hostname = app.nio.com, gateway-front-external.nio.com, api-fx.nio.com, icar.nio.com, matrix-api.nio.com
