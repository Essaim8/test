#!name=蔚来每日签到
#!desc=蔚来 App(com.do1.WeiLaiApp) 每日自动签到。原理：抓包显示签到有两条通道——native 的 POST app.nio.com/c/award_cn/checkin 带 sha256 sign 且服务端防重放(原样重放返回 sign_replay、只改 timestamp 返回 invalid sign)，签名无法离线复刻；而 webview 通道 gateway-front-external.nio.com/moat/10086/c/award_cn/checkin 客户端不传 sign，由网关自己补签，只认 authorization: Bearer。本插件只在 App 启动的两条心跳请求上抄 token(纯本地记录、立刻放行、不发任何请求，不影响 App 使用)，签到由 cron/手动按钮独立完成，走免签名的网关通道。不改安装包、无需越狱。**前提：已登录**。
#!author=@Essaim
#!icon=https://raw.githubusercontent.com/Essaim8/test/main/icon/nio.png
#!other=NIO.Loon.plugin

[Script]
# 只拦这两条启动心跳：它们 URL 里就带 accessToken，且带 authorization 头。
# 脚本只把 token 存下来，然后立刻 $done({}) 放行——绝不发网络请求、不阻塞 App。
http-request ^https?:\/\/app\.nio\.com\/api\/1\/message\/(update_client|bind_client)\b script-path=https://raw.githubusercontent.com/Essaim8/test/main/NIOCheckIn.js, timeout=10, tag=蔚来-登录态
# 定时签到（主路径，默认每天 09:07）
cron "7 9 * * *" script-path=https://raw.githubusercontent.com/Essaim8/test/main/NIOCheckIn.js, tag=蔚来-每日签到
# 手动触发：插件详情页点一下立即签到/自检
generic script-path=https://raw.githubusercontent.com/Essaim8/test/main/NIOCheckIn.js, tag=蔚来-立即签到, img-url=checkmark.circle.system

[MitM]
hostname = app.nio.com
